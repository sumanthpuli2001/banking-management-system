# ==============================================================================
# APEX NATIONAL BANK (BMS v2.4) — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Server Ports
PORT=8989
VITE_PORT=5173

# Spring Datasource (Local MySQL or TiDB Cloud)
# Local: jdbc:mysql://localhost:3306/enterprise_bank_db?createDatabaseIfNotExist=true&useSSL=false
# Cloud TiDB: jdbc:mysql://<tidb-host>:4000/enterprise_bank_db?sslMode=VERIFY_IDENTITY&enabledTLSProtocols=TLSv1.2,TLSv1.3
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/enterprise_bank_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=root

# Banking Security & JWT Parameters
BANKING_JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B59704428472B4B6250645367566B59703272357538782F413F4428472B4B62506453
BANKING_JWT_ACCESS_EXPIRATION_MS=86400000
BANKING_JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Allowed Origins (Comma-separated)
BANKING_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend Environment Variable (Vite)
VITE_API_URL=http://localhost:8989/api/v1
